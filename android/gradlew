#!/bin/sh
# Gradle wrapper script
# 简化版 - 直接调用 gradle 命令

# 尝试找到 gradle
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
elif [ -n "$GRADLE_HOME" ]; then
    exec "$GRADLE_HOME/bin/gradle" "$@"
else
    echo "Error: gradle not found. Please install Gradle or set GRADLE_HOME"
    exit 1
fi
