<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 NCM Decoder Pro"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="批量解密 · 自动识别歌名 · 写入封面与标签 · v2.0"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#888"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_pick_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂 选择单个 NCM 文件"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_pick_multi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂 批量选择 NCM 文件"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:max="100" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="就绪，点击上方按钮选择文件\n\n提示: 解密后的文件会保存到公共音乐库 NCM Decoder 文件夹"
            android:textSize="14sp"
            android:gravity="top|start"
            android:textColor="#555"
            android:typeface="monospace"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ 设置"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ 关于 / 使用说明"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
